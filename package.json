{
  "name": "chirping-astro",
  "version": "1.1.0",
  "type": "module",
  "description": "A Chirpy-inspired Astro v7 theme with Tailwind v4, daisyUI, MDX, Pagefind, and Telegram comments.",
  "license": "MIT",
  "private": false,
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "astro dev --force",
    "start": "astro dev --force",
    "stop": "astro dev stop --force",
    "build": "SKIP_KEYSTATIC=true astro build --force && bun run pagefind",
    "preview": "astro preview",
    "serve": "bun run build && bun preview",
    "astro": "astro",
    "pagefind": "pagefind --site dist --output-subdir _pagefind",
    "postbuild": "echo \"Pagefind index generated in dist/_pagefind\"",
    "typecheck": "astro check",
    "test": "bun test",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{astro,ts,tsx,js,jsx,md,mdx,css,json}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,tsx,js,jsx,md,mdx,css,json}\""
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.1",
    "@astrojs/react": "^6.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@keystatic/astro": "^5.2.0",
    "@keystatic/core": "^0.5.51",
    "astro": "7.3.2",
    "astro-expressive-code": "^0.44.2",
    "astro-icon": "^1.1.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/lato": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "@iconify-json/lucide": "^1.2.132",
    "@iconify-json/simple-icons": "^1.2.96",
    "@tailwindcss/vite": "^4.3.2",
    "@types/bun": "^1.4.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "daisyui": "^5.7.38",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^2.1.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "katex": "^0.17.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.3.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  },
  "keywords": [
    "astro",
    "astro-theme",
    "chirpy",
    "tailwindcss",
    "daisyui",
    "mdx",
    "pagefind",
    "telegram",
    "i18n",
    "blog"
  ]
}
