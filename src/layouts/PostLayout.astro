---
import BaseLayout from './BaseLayout.astro';
import PostNav from '../components/PostNav.astro';
import SmartImage from '../components/SmartImage.astro';
import TableOfContents from '../components/islands/TableOfContents.astro';
import TelegramComments from '../components/islands/TelegramComments.astro';
import MathStyles from '../components/MathStyles.astro';
import { Icon } from 'astro-icon/components';
import { SITE, TELEGRAM_COMMENTS } from '../config';
import { useTranslations, formatDate, isoDate } from '../i18n/utils';
import { type Post, heroImage, heroImageSrc, shouldShowHero } from '../utils/posts';
import { buildSeo } from '../utils/seo';
import { getRepositoryForPost, repositoryPath } from '../utils/repositories';
import { githubCommitUrl } from '../utils/repository';
import { getTagsForPost, tagPath } from '../utils/tags';
import type { MarkdownHeading } from 'astro';

interface Props {
  post: Post;
  /** Astro's `headings` array from `await render(post)`. */
  headings: MarkdownHeading[];
  prev?: Post;
  next?: Post;
}

const { post, headings, prev, next } = Astro.props;
const t = useTranslations();
const repository = await getRepositoryForPost(post);
const tags = await getTagsForPost(post);
const tagNames = tags.map((tag) => tag.entry.data.name);
const commitHash = post.data.commitHash;
const commitUrl =
  repository && commitHash ? githubCommitUrl(repository.entry.data.github, commitHash) : undefined;

const commentsDisabled = post.data.comments === false;
const telegramCommentsEnabled =
  !commentsDisabled &&
  TELEGRAM_COMMENTS.enabled &&
  Boolean(TELEGRAM_COMMENTS.channel) &&
  Boolean(post.data.telegramPostId);

const heroSrc = heroImageSrc(post);
const heroAsset = heroImage(post);
const showHero = shouldShowHero(post);
const heroAlt = post.data.heroImageAlt ?? '';

const articleClass = SITE.boxedArticles
  ? 'border-base-300 bg-base-100 rounded-md border px-5 py-8 sm:px-8 sm:py-10'
  : '';

// Use the hero image for social previews when present. buildSeo falls back to
// the site's default OG image without generating a per-post asset.
const heroMetadata = typeof heroAsset === 'object' ? heroAsset : undefined;
const heroMimeType = heroMetadata
  ? `image/${heroMetadata.format.replace('jpg', 'jpeg')}`
  : undefined;

const seo = buildSeo({
  title: post.data.title,
  description: post.data.description,
  fullPath: Astro.url.pathname,
  ogImage: heroSrc,
  ogImageWidth: heroMetadata?.width,
  ogImageHeight: heroMetadata?.height,
  ogImageType: heroMimeType,
  type: 'article',
  publishedTime: post.data.pubDate,
  modifiedTime: post.data.updatedDate,
  tags: tagNames,
  // An unlisted post hides from SEO by default unless the author
  // explicitly sets `unlistedHideFromSeo: false`.
  noindex: post.data.unlisted && (post.data.unlistedHideFromSeo ?? true),
});

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': seo.canonical,
  },
  headline: post.data.title,
  description: post.data.description,
  image: seo.ogImage,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
  author: {
    '@type': 'Person',
    name: SITE.author.name,
    ...(SITE.author.url ? { url: SITE.author.url } : {}),
  },
  publisher: {
    '@type': 'Person',
    name: SITE.author.name,
    ...(SITE.author.url ? { url: SITE.author.url } : {}),
  },
  ...(tagNames.length > 0 ? { keywords: tagNames } : {}),
};

const crumbs = [{ label: post.data.title }];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
  tags={tagNames}
  crumbs={crumbs}
  seo={seo}
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(articleJsonLd)}
  />
  {post.data.math && <MathStyles />}
  {
    post.data.toc && headings.length > 0 && (
      <TableOfContents slot="aside-bottom" headings={headings} variant="desktop" />
    )
  }
  {
    post.data.toc && headings.length > 0 && (
      <TableOfContents headings={headings} variant="floating" />
    )
  }

  <article
    class:list={['post', articleClass]}
    itemscope
    itemtype="https://schema.org/BlogPosting"
    itemid={seo.canonical}
  >
    <header class="post-header mb-8">
      <h1
        class="post-title text-base-content text-3xl leading-none font-extrabold tracking-tight sm:text-[2.25rem] sm:leading-tight"
        itemprop="headline"
      >
        {post.data.title}
      </h1>
      <p class="post-description text-base-content/65 mt-4 text-lg" itemprop="description">
        {post.data.description}
      </p>

      <div class="text-base-content/70 mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
        <span class="inline-flex items-center gap-1">
          <Icon name="lucide:calendar-days" width={14} height={14} />
          <time
            class="post-published"
            itemprop="datePublished"
            datetime={isoDate(post.data.pubDate)}
          >
            {formatDate(post.data.pubDate)}
          </time>
        </span>
        {
          repository && (
            <span class="inline-flex items-center gap-1.5">
              <Icon
                name="lucide:github"
                width={15}
                height={15}
                class="shrink-0"
                aria-label={t('post.repository')}
                role="img"
              />
              <a
                href={repositoryPath(repository.slug)}
                class="text-primary font-semibold hover:underline"
              >
                {repository.entry.data.github}
              </a>
            </span>
          )
        }
        {
          commitUrl && commitHash && (
            <span class="inline-flex items-center gap-1.5">
              <Icon
                name="lucide:git-commit"
                width={15}
                height={15}
                class="shrink-0"
                aria-label={t('post.commit')}
                role="img"
              />
              <a
                href={commitUrl}
                class="text-primary inline-flex items-center gap-1 font-mono font-semibold hover:underline"
                target="_blank"
                rel="noopener noreferrer"
              >
                {commitHash.slice(0, 7)}
              </a>
            </span>
          )
        }
        {
          post.data.updatedDate && (
            <span class="inline-flex items-center gap-1">
              <Icon name="lucide:check" width={14} height={14} />
              <time
                class="post-modified"
                itemprop="dateModified"
                datetime={isoDate(post.data.updatedDate)}
              >
                {t('post.updatedOn')} {formatDate(post.data.updatedDate)}
              </time>
            </span>
          )
        }
      </div>
    </header>

    {
      showHero && heroAsset && (
        <figure class="post-cover post-hero mb-8">
          <div class="post-hero__frame">
            <SmartImage
              src={heroAsset}
              alt={heroAlt}
              class="post-hero__img"
              loading="eager"
              widths={[480, 768, 1024, 1280, 1600]}
              sizes="(max-width: 768px) 100vw, 1024px"
              quality={82}
              itemprop="image"
            />
          </div>
          {heroAlt && (
            <figcaption class="text-base-content/70 mt-2 text-center text-xs">{heroAlt}</figcaption>
          )}
        </figure>
      )
    }

    <div class="post-content prose-chirpy max-w-none" itemprop="articleBody">
      <slot />
    </div>

    {
      tags.length > 0 && (
        <footer class="mt-10 flex flex-wrap items-center gap-2">
          <span class="text-base-content/70 inline-flex h-6 w-6 items-center justify-center">
            <Icon
              name="lucide:tags"
              width={18}
              height={18}
              aria-label={t('post.tags')}
              role="img"
            />
          </span>
          {tags.map((tag) => (
            <a href={tagPath(tag.slug)} class="post-tag text-xs">
              {tag.entry.data.name}
            </a>
          ))}
        </footer>
      )
    }

    <PostNav prev={prev} next={next} />

    {
      telegramCommentsEnabled && post.data.telegramPostId ? (
        <TelegramComments postId={post.data.telegramPostId} />
      ) : (
        commentsDisabled && (
          <p class="text-base-content/70 mt-10 text-sm">{t('post.commentsDisabled')}</p>
        )
      )
    }
  </article>
</BaseLayout>
