---
import { Icon } from 'astro-icon/components';

import GitHubStars from '~/components/GitHubStars.astro';
import PostList from '~/components/PostList.astro';
import { localizedPath, useTranslations } from '~/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { githubRepositoryUrl } from '~/utils/repository';
import { getRepositoriesWithPosts, type RepositoryWithPosts } from '~/utils/repositories';

interface Props {
  repository: RepositoryWithPosts;
}

export async function getStaticPaths() {
  const repositories = await getRepositoriesWithPosts();
  return repositories.map((repository) => ({
    params: { repo: repository.slug },
    props: { repository },
  }));
}

const { repository } = Astro.props as Props;
const t = useTranslations();
const githubUrl = githubRepositoryUrl(repository.entry.data.github);
---

<BaseLayout
  title={repository.entry.data.github}
  description={repository.entry.data.description}
  crumbs={[
    { label: t('repos.title'), href: localizedPath('/repos/') },
    { label: repository.entry.data.github },
  ]}
>
  <header class="mb-8">
    <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-4 gap-y-1">
      <p class="text-base-content/70 col-start-1 row-start-1 text-sm tracking-wide uppercase">
        {t('list.repositoryPosts')}
      </p>
      <h1
        class="col-span-2 row-start-2 flex min-w-0 items-center gap-2 text-2xl leading-none font-bold tracking-tight sm:col-span-1 sm:text-3xl"
      >
        <Icon name="lucide:github" width={26} height={26} class="shrink-0" aria-hidden="true" />
        <a
          href={githubUrl}
          class="hover:text-primary min-w-0 wrap-break-word transition-colors"
          target="_blank"
          rel="noopener noreferrer"
        >
          {repository.entry.data.github}
        </a>
        <span class="tag-post-count shrink-0">{repository.posts.length}</span>
      </h1>

      <div class="col-start-2 row-start-1 flex shrink-0 items-center">
        <GitHubStars repository={repository.entry.data.github} />
      </div>
    </div>
    <p class="text-base-content/70 mt-4 max-w-3xl text-base leading-relaxed">
      {repository.entry.data.description}
    </p>
  </header>
  <PostList posts={repository.posts} />
</BaseLayout>
