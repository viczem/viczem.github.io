---
import { Icon } from 'astro-icon/components';

import GitHubStars from '~/components/GitHubStars.astro';
import { useTranslations } from '~/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getRepositoriesWithPosts, repositoryPath } from '~/utils/repositories';

const t = useTranslations();
const repositories = await getRepositoriesWithPosts();
---

<BaseLayout title={t('repos.title')} crumbs={[{ label: t('repos.title') }]}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold tracking-tight">{t('repos.title')}</h1>
  </header>
  {
    repositories.length === 0 ? (
      <p class="text-base-content/70">{t('repos.empty')}</p>
    ) : (
      <ul class="grid gap-4 md:grid-cols-2">
        {repositories.map((repository) => (
          <li class="border-base-300 bg-base-100 rounded-lg border p-4 sm:p-5">
            <article class="flex h-full flex-col">
              <div class="flex items-center justify-between gap-3">
                <h2 class="flex min-w-0 items-center text-base leading-none font-bold">
                  <a
                    href={repositoryPath(repository.slug)}
                    class="hover:text-primary inline-flex max-w-full min-w-0 items-center gap-1.5 transition-colors"
                  >
                    <Icon
                      name="lucide:github"
                      width={18}
                      height={18}
                      class="shrink-0"
                      aria-hidden="true"
                    />
                    <span class="min-w-0 [overflow-wrap:anywhere]">
                      {repository.entry.data.github}
                    </span>
                  </a>
                </h2>
                <GitHubStars repository={repository.entry.data.github} />
              </div>
              <p class="text-base-content/70 mt-3 flex-1 text-sm leading-relaxed">
                {repository.entry.data.description}
              </p>
            </article>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
