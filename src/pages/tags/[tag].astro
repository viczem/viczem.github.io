---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostList from '~/components/PostList.astro';
import { useTranslations, localizedPath } from '~/i18n/utils';
import { getTagsWithPosts, type TagWithPosts } from '~/utils/tags';
import { Icon } from 'astro-icon/components';

interface Props {
  tag: TagWithPosts;
}

export async function getStaticPaths() {
  const tags = await getTagsWithPosts();
  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { tag },
  }));
}

const { tag } = Astro.props as Props;
const t = useTranslations();
---

<BaseLayout
  title={tag.entry.data.name}
  crumbs={[
    { label: t('tags.title'), href: localizedPath('/tags/') },
    { label: tag.entry.data.name },
  ]}
>
  <header class="mb-6">
    <p class="text-base-content/70 text-sm tracking-wide uppercase">{t('list.tagPosts')}</p>
    <h1 class="flex items-center gap-2 text-3xl font-bold tracking-tight">
      <Icon name="lucide:tag" width={28} height={28} aria-hidden="true" />
      {tag.entry.data.name}
      <span class="tag-post-count">{tag.posts.length}</span>
    </h1>
  </header>
  <PostList posts={tag.posts} />
</BaseLayout>
